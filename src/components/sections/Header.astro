---
import { createWhatsAppUrl } from '../../utils/whatsapp';
import business from '../../data/business.json';

const firstName = business.company.contactPerson.split(' ')[0];
const whatsappUrl = createWhatsAppUrl(
  business.contact.whatsappNumber,
  `Olá, ${firstName}! Vim pelo site da ${business.company.name} e gostaria de um orçamento.`
);
---

<header class="w-full h-16 sm:h-20 shrink-0 z-50 border-b border-white/10 bg-[#061022]/90 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-full flex items-center justify-between gap-3">
    
    <a href="#hero" class="flex items-center gap-3 group shrink-0">
      <div class="w-10 h-10 sm:w-20 sm:h-20 flex items-center justify-center p-1 transition shrink-0">
        <div 
          class="w-full h-full bg-vivid mask-[url(/logo-madeinpolar.svg)] [-webkit-mask-image:url(/logo-madeinpolar.svg)] mask-contain mask-no-repeat mask-center"
          role="img"
          aria-label={`Logo ${business.company.name}`}>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="block text-sm sm:text-base font-extrabold tracking-wider text-white leading-none uppercase">
          MADE IN <span class="text-vivid">POLAR</span>
        </span>
        <span class="hidden sm:block text-[10px] tracking-[0.2em] uppercase text-slate-400 mt-1">
          Climatização • Elétrica
        </span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
      <a href="#beneficios" class="hover:text-white transition">Diferenciais</a>
      <a href="#servicos" class="hover:text-white transition">Serviços</a>
      <a href="#como-funciona" class="hover:text-white transition">Como Funciona</a>
      <a href="#galeria" class="hover:text-white transition">Galeria</a>
      <a href="#avaliacoes" class="hover:text-white transition">Avaliações</a>
      <a href="#contato" class="hover:text-white transition">Dúvidas</a>
    </nav>

    <a 
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="px-3.5 py-2 sm:px-5 sm:py-2.5 rounded-full bg-white/10 text-white text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center gap-1.5 sm:gap-2 whitespace-nowrap shrink-0 hover:bg-whatsapp active:scale-95 shadow-sm"
    >
      <span class="hidden sm:inline">Falar no</span>
      <span>WhatsApp</span>
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white group-hover:text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

  </div>
</header>