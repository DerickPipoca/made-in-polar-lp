---
import ScrollIndicator from '../ui/ScrollIndicator.astro';
import business from '../../data/business.json';

const { testimonials, location } = business;
---

<section id="avaliacoes" class="deck-slide w-full px-4 sm:px-6">
  <div class="hidden sm:block" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto w-full my-auto space-y-4 sm:space-y-8">
    
    {/* Cabeçalho */}
    <div class="text-center max-w-2xl mx-auto space-y-1 sm:space-y-2">
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-vivid">
        Clientes em {location.city}
      </span>
      <h2 class="text-xl sm:text-4xl font-extrabold text-white leading-tight">
        Quem Já Conhece o Padrão Polar
      </h2>
    </div>

    {/* Lista de Depoimentos */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-6">
      {testimonials.map((item) => (
        <div class="p-4 sm:p-6 rounded-2xl sm:rounded-3xl bg-navy/60 border border-white/10 flex flex-col justify-between space-y-2.5 sm:space-y-4 shadow-lg">
          
          <div class="space-y-2 sm:space-y-3">
            {/* Estrelas em SVG */}
            <div class="flex items-center gap-1 text-yellow" aria-label={`Avaliação ${item.rating} de 5 estrelas`}>
              {Array.from({ length: item.rating }).map(() => (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))}
            </div>

            <p class="text-[11px] sm:text-sm text-slate-300 leading-snug sm:leading-relaxed italic">
              "{item.comment}"
            </p>
          </div>

          <div class="pt-2 border-t border-white/5 flex items-center justify-between">
            <div>
              <p class="text-xs sm:text-sm font-bold text-white leading-none">{item.name}</p>
              <span class="block text-[10px] sm:text-xs text-vivid mt-1">{item.role}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>

  <ScrollIndicator targetId="#contato" label="Perguntas Frequentes" />
</section>