---
import { createWhatsAppUrl } from '../../utils/whatsapp';
import business from '../../data/business.json';

const firstName = business.company.contactPerson.split(' ')[0];
const whatsappUrl = createWhatsAppUrl(
  business.contact.whatsappNumber,
  `Olá, ${firstName}! Vim pelo site da ${business.company.name} e gostaria de solicitar um orçamento.`
);
---

<section id="contato" class="deck-slide w-full px-4 sm:px-6 justify-between">
  <div class="hidden sm:block" aria-hidden="true"></div>

  <div class="max-w-3xl mx-auto w-full my-auto space-y-3 sm:space-y-4">
    <div class="text-center space-y-0.5 sm:space-y-1">
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-vivid">
        Tire suas dúvidas
      </span>
      <h2 class="text-xl sm:text-3xl font-extrabold text-white">
        Perguntas Frequentes
      </h2>
    </div>

    {/* Lista Dinâmica com as 5 Perguntas do business.json */}
    <div class="space-y-1.5 sm:space-y-2">
      {business.faqs.map((faq) => (
        <details class="group rounded-xl sm:rounded-2xl bg-navy/60 border border-white/10 px-3.5 sm:px-5 py-2 sm:py-2.5 transition open:border-vivid/40">
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-white text-xs sm:text-sm">
            <span>{faq.question}</span>
            <svg class="w-4 h-4 text-vivid transition-transform group-open:rotate-180 shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </summary>
          <p class="mt-1.5 text-[11px] sm:text-xs text-slate-300 border-t border-white/10 pt-1.5 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>

    {/* CTA Final */}
    <div class="text-center pt-1">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-whatsapp hover:bg-whatsapp-hover text-white font-bold text-xs sm:text-sm transition-all shadow-[0_0_30px_-5px_rgba(0,153,0,0.5)] inline-flex items-center gap-2 active:scale-95"
      >
        <span>Falar no WhatsApp: {business.contact.displayPhone}</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  {/* Rodapé Integrado com Dados do JSON */}
  <footer class="w-full max-w-6xl mx-auto pt-2.5 pb-12 sm:pb-1 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-1.5 text-[10px] sm:text-[11px] text-slate-400">
    <div class="flex flex-wrap items-center justify-center gap-2">
      <span class="font-extrabold text-white uppercase">MADE IN <span class="text-vivid">POLAR</span></span>
      {business.company.cnpj !== "00.000.000/0001-00" && (
        <>
          <span>•</span>
          <span>CNPJ: {business.company.cnpj}</span>
        </>
      )}
    </div>
    <div class="flex items-center gap-4">
      <a href={business.company.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-vivid transition">
        {business.company.instagram}
      </a>
      <span>{business.location.city} - {business.location.state} e Região</span>
    </div>
  </footer>
</section>

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Falar com a ${business.company.name} pelo WhatsApp`}
  class="fixed bottom-4 right-4 sm:bottom-5 sm:right-5 z-50 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-whatsapp hover:bg-whatsapp-hover flex items-center justify-center shadow-[0_8px_25px_rgba(37,211,102,0.45)] transition-transform hover:scale-105 active:scale-95"
>
  <div 
    class="w-6 h-6 sm:w-9 sm:h-9 bg-white mask-[url(/whatsapp.svg)] mask-contain mask-no-repeat mask-center"
    role="img"
    aria-hidden="true"
  ></div>
</a>