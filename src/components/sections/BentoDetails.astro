---
import ScrollIndicator from '../ui/ScrollIndicator.astro';
---

<section id="beneficios" class="deck-slide w-full px-4 sm:px-6 py-3 sm:py-4">
  <div class="hidden sm:block" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto w-full my-auto space-y-4 sm:space-y-8">
    <div class="text-center max-w-2xl mx-auto space-y-1 sm:space-y-2">
      <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-vivid">
        Padrão Made In Polar
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
        Resultados Imediatos no Seu Ambiente
      </h2>
    </div>

    {/* 3 Indicadores: Horizontal no Mobile, Vertical no Desktop */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6">
      
      <div class="p-4 sm:p-8 rounded-2xl sm:rounded-3xl bg-navy/60 border border-white/10 flex sm:block items-center justify-between gap-4 text-left sm:text-center sm:space-y-2 shadow-lg">
        <span class="text-2xl sm:text-5xl font-extrabold text-vivid shrink-0">Até -30%</span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white">Economia de Energia</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">O aparelho limpo refrigera mais rápido e alivia o compressor.</p>
        </div>
      </div>

      <div class="p-4 sm:p-8 rounded-2xl sm:rounded-3xl bg-navy/60 border border-white/10 flex sm:block items-center justify-between gap-4 text-left sm:text-center sm:space-y-2 shadow-lg">
        <span class="text-2xl sm:text-5xl font-extrabold text-white shrink-0">99,9%</span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white">Ar Descontaminado</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">Elimina colônias de fungos, ácaros e o mau cheiro ao ligar.</p>
        </div>
      </div>

      <div class="p-4 sm:p-8 rounded-2xl sm:rounded-3xl bg-navy/60 border border-white/10 flex sm:block items-center justify-between gap-4 text-left sm:text-center sm:space-y-2 shadow-lg">
        <span class="text-2xl sm:text-5xl font-extrabold text-yellow shrink-0">+ Tempo</span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white">Vida útil do aparelho</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">Previne falhas causadas por sujeira acumulada.</p>
        </div>
      </div>

    </div>

    {/* Modelos Atendidos */}
    <div class="p-3.5 sm:p-5 rounded-2xl bg-white/3 border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-center sm:text-left">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 sm:gap-2 text-[11px] sm:text-sm text-slate-300">
        <span class="font-bold text-white">Modelos:</span>
        <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">Split Hi-Wall</span>
        <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">Inverter</span>
        <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">Piso Teto</span>
        <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">Cassete</span>
        <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10">Entre outros...</span>
      </div>
      <span class="text-[11px] sm:text-xs font-semibold text-vivid shrink-0">
        ✓ Emissão de Nota Fiscal para sua empresa
      </span>
    </div>
  </div>

  <ScrollIndicator targetId="#servicos" label="Ver nossos serviços" />
</section>