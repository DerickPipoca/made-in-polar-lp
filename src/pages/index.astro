---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import BentoDetails from '../components/sections/BentoDetails.astro';
import Services from '../components/sections/Services.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Gallery from '../components/sections/Gallery.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Footer from '../components/sections/Footer.astro';
import business from '../data/business.json';
---

<BaseLayout 
  title={`${business.company.name} | Climatização, Refrigeração e Elétrica em ${business.location.city}`}
  description={business.company.description}
>
  <Header />
  <main id="deck-container" class="w-full">
    <Hero />
    <BentoDetails />
    <Services />
    <HowItWorks />
    <Gallery />
    <Testimonials />
    <Footer />
  </main>
</BaseLayout>