---
import '../styles/global.css';
import business from '../data/business.json';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${business.company.name} | Climatização e Elétrica em ${business.location.city}`, 
  description = business.company.description 
} = Astro.props;

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "HVACBusiness",
    "name": business.company.name,
    "description": business.company.description,
    "url": business.company.url,
    "telephone": `+${business.contact.whatsappNumber}`,
    "taxID": business.company.cnpj,
    "founder": {
      "@type": "Person",
      "name": business.company.contactPerson
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": business.location.city,
      "addressRegion": business.location.state,
      "postalCode": business.location.postalCode,
      "addressCountry": business.location.country
    },
    "areaServed": {
      "@type": "City",
      "name": business.location.city,
      "containedInPlace": {
        "@type": "State",
        "name": business.location.stateName
      }
    },
    "sameAs": [business.company.instagramUrl],
    "priceRange": "$$",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": String(business.testimonials.length)
    },
    "review": business.testimonials.map((t) => ({
      "@type": "Review",
      "author": { "@type": "Person", "name": t.name },
      "reviewRating": { "@type": "Rating", "ratingValue": String(t.rating) },
      "reviewBody": t.comment
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": business.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<!doctype html>
<html lang="pt-BR" class="bg-[#061022] text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#061022" />

    <link rel="icon" type="image/svg+xml" href="/logo-madeinpolar.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="canonical" href={business.company.url} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={business.company.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={business.company.name} />

    {/* Dados Estruturados JSON-LD (Empresa + Avaliações + FAQ) */}
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="w-full min-h-screen m-0 p-0 bg-[#061022] text-slate-100 antialiased selection:bg-vivid selection:text-white overflow-x-hidden relative">
    
    {/* Iluminação polar contínua de fundo */}
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-225 h-125 bg-blue/15 rounded-full blur-[150px]"></div>
      <div class="absolute top-[60vh] -left-40 w-125 h-125 bg-vivid/10 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-0 right-0 w-150 h-150 bg-navy/60 rounded-full blur-[150px]"></div>
    </div>

    <div class="relative z-10 w-full">
      <slot />
    </div>

    {/* Indicadores Laterais de Lâmina (Desktop) */}
    <div id="deck-dots" class="hidden lg:flex fixed right-6 top-1/2 -translate-y-1/2 z-40 flex-col gap-3">
      <button data-slide="0" aria-label="Início" class="deck-dot w-2.5 h-2.5 rounded-full bg-vivid scale-125 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="1" aria-label="Diferenciais" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="2" aria-label="Serviços" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="3" aria-label="Como Funciona" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="4" aria-label="Galeria" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="5" aria-label="Avaliações" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
      <button data-slide="6" aria-label="FAQ e Contato" class="deck-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all duration-300 cursor-pointer"></button>
    </div>

    <script is:inline>
      function initDeckController() {
        const container = document.getElementById('deck-container');
        const slides = Array.from(document.querySelectorAll('.deck-slide'));
        const dots = Array.from(document.querySelectorAll('.deck-dot'));
        const navLinks = Array.from(document.querySelectorAll('header nav a'));
        if (!container || !slides.length) return;

        let currentIndex = 0;
        let isAnimating = false;
        const SCROLL_DURATION = 800;

        function activateSlide(index) {
          slides.forEach((s, i) => {
            s.classList.toggle('is-active', i === index);
          });

          dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.add('bg-vivid', 'scale-125');
              dot.classList.remove('bg-white/20');
            } else {
              dot.classList.remove('bg-vivid', 'scale-125');
              dot.classList.add('bg-white/20');
            }
          });

          const activeId = slides[index]?.id;
          navLinks.forEach((link) => {
            const isMatch = link.getAttribute('href') === `#${activeId}`;
            link.classList.toggle('text-vivid', isMatch);
            link.classList.toggle('font-bold', isMatch);
          });
        }

        function smoothScrollContainer(targetY, duration, onComplete) {
          const startY = container.scrollTop;
          const difference = targetY - startY;
          let startTime = null;

          function easeInOutCubic(t) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function step(currentTime) {
            if (!startTime) startTime = currentTime;
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = easeInOutCubic(progress);

            container.scrollTop = startY + difference * eased;

            if (elapsed < duration) {
              requestAnimationFrame(step);
            } else {
              container.scrollTop = targetY;
              if (onComplete) onComplete();
            }
          }

          requestAnimationFrame(step);
        }

        function goToSlide(index) {
          if (index < 0 || index >= slides.length || isAnimating) return;
          isAnimating = true;
          currentIndex = index;

          activateSlide(currentIndex);
          const targetTop = slides[currentIndex].offsetTop;

          smoothScrollContainer(targetTop, SCROLL_DURATION, () => {
            isAnimating = false;
          });
        }

        window.addEventListener('resize', () => {
          container.scrollTop = slides[currentIndex].offsetTop;
        });

        let wheelDelta = 0;
        container.addEventListener('wheel', (e) => {
          e.preventDefault();
          if (isAnimating) {
            wheelDelta = 0;
            return;
          }
          wheelDelta += e.deltaY;
          if (wheelDelta > 50) {
            wheelDelta = 0;
            goToSlide(currentIndex + 1);
          } else if (wheelDelta < -50) {
            wheelDelta = 0;
            goToSlide(currentIndex - 1);
          }
        }, { passive: false });

        let touchStartY = 0;
        let touchStartX = 0;

        container.addEventListener('touchstart', (e) => {
          touchStartY = e.touches[0].clientY;
          touchStartX = e.touches[0].clientX;
        }, { passive: true });

        container.addEventListener('touchmove', (e) => {
          if (e.target.closest('[data-horizontal-scroll]')) {
            const currentX = e.touches[0].clientX;
            const currentY = e.touches[0].clientY;
            if (Math.abs(currentX - touchStartX) > Math.abs(currentY - touchStartY)) {
              return;
            }
          }
          e.preventDefault();
        }, { passive: false });

        container.addEventListener('touchend', (e) => {
          if (isAnimating) return;
          const diffY = touchStartY - e.changedTouches[0].clientY;
          const diffX = Math.abs(touchStartX - e.changedTouches[0].clientX);

          if (Math.abs(diffY) > 40 && Math.abs(diffY) > diffX) {
            if (diffY > 0) {
              goToSlide(currentIndex + 1);
            } else {
              goToSlide(currentIndex - 1);
            }
          }
        }, { passive: true });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'PageDown') {
            e.preventDefault();
            goToSlide(currentIndex + 1);
          } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
            e.preventDefault();
            goToSlide(currentIndex - 1);
          }
        });

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const targetId = anchor.getAttribute('href').slice(1);
            const targetIndex = slides.findIndex((s) => s.id === targetId);
            if (targetIndex !== -1) {
              e.preventDefault();
              goToSlide(targetIndex);
            }
          });
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const targetIdx = Number(dot.getAttribute('data-slide'));
            goToSlide(targetIdx);
          });
        });

        const detailsList = document.querySelectorAll('details');
        detailsList.forEach((targetDetail) => {
          targetDetail.addEventListener('toggle', () => {
            if (targetDetail.open) {
              detailsList.forEach((detail) => {
                if (detail !== targetDetail) detail.removeAttribute('open');
              });
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDeckController);
      } else {
        initDeckController();
      }
    </script>
  </body>
</html>